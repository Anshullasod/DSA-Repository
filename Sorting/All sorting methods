#include <iostream>
#include <vector>
#include <algorithm>
#include <climits>

using namespace std;

void bubblesort(int a[], int n) {
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n - 1; j++) {
            if (a[j] > a[j + 1]) {
                swap(a[j], a[j + 1]);
            }
        }
    }
}

void selectionsort(int a[], int n) {
    for (int i = 0; i < n - 1; i++) {
        int mini = i; // 'mini' index store karta hai
        for (int j = i + 1; j < n; j++) {
            if (a[mini] > a[j]) {
                mini = j;
            }
        }
        swap(a[i], a[mini]);
    }
}

void insertsort(int a[], int n) {
    for (int i = 1; i < n; i++) {
        int cur = a[i];
        int prev = i - 1;
        while (prev >= 0 && a[prev] > cur) {
            a[prev + 1] = a[prev]; // Shift elements
            prev--;
        }
        a[prev + 1] = cur;
    }
}

void countsort(int a[], int n) {
    int minval = INT_MAX, maxval = INT_MIN;
    int freq[10000] = {0};

    for (int i = 0; i < n; i++) {
        minval = min(minval, a[i]);
        maxval = max(maxval, a[i]);
        freq[a[i]]++;
    }

    for (int i = minval, j = 0; i <= maxval; i++) {
        while (freq[i] > 0) {
            a[j] = i;
            j++;
            freq[i]--;
        }
    }
}

int main() {
    int a[] = {3, 6, 2, 1, 8, 7, 4, 5, 3, 1};
    int n = 10;

    // Aap yahan kisi bhi function ko call kar sakte hain, jaise:
    selectionsort(a, n);

    cout << "Sorted array: ";
    for (int i = 0; i < n; i++) {
        cout << a[i] << " ";
    }

    return 0;
}
